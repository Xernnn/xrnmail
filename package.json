{
  "name": "xrnmail",
  "version": "1.1.0",
  "description": "All your mail accounts in one place, delivered in batches",
  "author": "xrn",
  "desktopName": "xrnmail.desktop",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "pack:linux": "npm run build && electron-builder --linux AppImage --x64",
    "app:install": "bash scripts/install-linux-app.sh"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.12.1",
    "lucide-react": "^1.70.0",
    "mailparser": "^3.14.3",
    "nodemailer": "^10.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^44.11.6",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
    }
  }
}
